    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test(\"User is created with default role 'user'\", function () {",
                  "    pm.expect(data.user.role).to.eql(\"user\");",
                  "});",
                  "pm.collectionVariables.set(\"newUserEmail\", data.user.email);",
                  "pm.test(\"Registered email stored in {{newUserEmail}}\", function () {",
                  "    pm.expect(pm.collectionVariables.get(\"newUserEmail\")).to.eql(data.user.email);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test User\",\n  \"email\": \"postman.{{$randomUUID}}@example.com\",\n  \"password\": \"{{newUserPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Registers a new user. The email is randomized with `{{$randomUUID}}` so the request can be re-run safely. Set `{{newUserPassword}}` before running. The created account always gets role `user` — there is no public way to register an admin.\n\nExpected: `201 { \"message\": \"User registered successfully\", \"user\": { ... } }`\nMissing fields → `400`. Duplicate email → `409`."
          },
          "response": []
        },
